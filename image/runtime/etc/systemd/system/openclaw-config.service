[Unit]
Description=Rebuild ephemeral OpenClaw configuration
Requires=persistainer.service
Wants=network-online.target tailscale-up.service
After=network-online.target persistainer.service tailscale-up.service
Before=openclaw.service

[Service]
Type=oneshot
Environment=HOME=/root
# This service owns generated config, including ExecStartPost plugin setup.
Environment=OPENCLAW_CONFIG_READONLY=0
ExecCondition=/bin/bash -c '[ "$${OPENCLAW_START:-1}" = "1" ]'
ExecStart=/usr/local/bin/openclaw-ephemeral.py configure
RemainAfterExit=yes
TimeoutStartSec=450

[Install]
WantedBy=multi-user.target
